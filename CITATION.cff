# Citation metadata for PEAR-EBI. GitHub renders the "Cite this repository" button in
# the sidebar from this file, and offers BibTeX and APA from it.
#
# `version:` is kept in step with pyproject.toml by tools/sync_version.py, which the
# release workflow runs; do not edit it by hand.
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "PEAR: Phylogeny Embedding and Approximate Representation"
abstract: >-
  PEAR computes pairwise distances between phylogenetic trees and embeds them in a
  low-dimensional space for visualisation, using Robinson-Foulds, quartet and triplet
  distances together with PCoA, t-SNE, Isomap and locally linear embedding.
type: software
license: MIT
version: 1.1.1
repository-code: "https://github.com/AndreaRubbi/Pear-EBI"
url: "https://andrearubbi.github.io/Pear-EBI/"
keywords:
  - phylogenetics
  - phylogenetic trees
  - tree distances
  - Robinson-Foulds
  - dimensionality reduction
authors:
  - family-names: Rubbi
    given-names: Andrea
    affiliation: "EMBL-European Bioinformatics Institute"
  - family-names: Weilguny
    given-names: Lukas
    affiliation: "EMBL-European Bioinformatics Institute"
  - family-names: Goldman
    given-names: Nick
    affiliation: "EMBL-European Bioinformatics Institute"
  - family-names: De Maio
    given-names: Nicola
    affiliation: "EMBL-European Bioinformatics Institute"
