# Built documentation. CI builds it on every push and deploys it to gh-pages,
# so a committed copy would be a second source of truth that can silently
# disagree with what is published. Preview locally with `mkdocs serve`.
site/
#docs/
#docs_assets/
pear_ebi.egg\-info/
__pycache__/
#build/
# poetry build output: regenerable artefacts, not sources. 46 MB of them were
# tracked; `poetry build` recreates them whenever they are needed.
dist/
#gendoc.py
#.isort.cfg
#.pre\-commit\-config.yaml
#mkdocs.yml
#mkgendocs.yml
#pyproject.toml
#MANIFEST.in
#.gitignore
#setup.cfg
#setup.py

# Graphify knowledge graph — regenerable, kept out of git deliberately
# (upstream suggests committing graphify-out/, but this repo's .git is already ~533 MB).
# NOTE: must be "graphify-out/", never "graph*" — pear_ebi/embeddings/graph/ is real source.
graphify-out/
.graphify/


# Coverage artefacts
.coverage
.coverage.*
htmlcov/

# Vendored native build byproducts. These were committed once (2149 files, 118 MB,
# including 441 CMake files carrying the maintainer's absolute home paths) and are
# regenerated by any local rebuild, so keep them out.
pear_ebi/calculate_distances/*/tqDist/build/
pear_ebi/calculate_distances/*/*/CMakeFiles/
pear_ebi/calculate_distances/*/*/CMakeCache.txt
pear_ebi/calculate_distances/*/*/.deps/
pear_ebi/calculate_distances/*/*/config.log
pear_ebi/calculate_distances/*/*/config.status
pear_ebi/calculate_distances/**/*.o
pear_ebi/calculate_distances/**/._*

# ─── PEAR run outputs ─────────────────────────────────────────────────────────
# Everything a normal run writes into the working directory. None of it belongs in
# git, and the test suite and the notebooks both generate it. Patterns are specific
# to the names PEAR actually produces so that tracked fixtures and the generated
# site/ are unaffected (verified: no tracked file is matched).
*_distance_matrix.csv
Set_collection_distance_matrix_*.csv
*_PCOA_embedding.csv
*_TSNE_embedding.csv
*_ISOMAP_embedding.csv
*_LLE_embedding.csv
PCoA_Embedding.csv
PCA_Embedding.csv
*_PCOA_2D.html
*_PCOA_3D.html
*_TSNE_2D.html
*_TSNE_3D.html
*_ISOMAP_2D.html
*_ISOMAP_3D.html
*_LLE_2D.html
*_LLE_3D.html
PCOA_2D.html
PCOA_3D.html
TSNE_2D.html
TSNE_3D.html
*_SUBSAMPLE
*_SUBSAMPLE_distances.csv
Trees.pckl
tmp_file

# notebook execution artefacts
executed.ipynb
ex.ipynb
*.exec-input.ipynb
*.executed.ipynb
.ipynb_checkpoints/

