# What must never be committed. Grouped by where it comes from; every pattern was
# checked against the tracked file list, and none of them shadows a tracked file.

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Packaging and build output ───────────────────────────────────────────────
# Regenerable artefacts, not sources. 46 MB of dist/ was tracked once; `poetry
# build` recreates it whenever it is needed.
dist/
build/
*.egg
*.egg-info/
.eggs/
# An egg-info left here also *shadows the installed metadata*: importlib.metadata
# searches sys.path, "" is on it whenever the working directory is the repository,
# so a stale copy wins over the real installation. tests/test_packaging.py fails
# while one is present.

# ─── Virtual environments ─────────────────────────────────────────────────────
# These are self-ignoring today (the tools write a .gitignore containing "*" inside
# them), which works but is not something to rely on.
.venv/
.venv.*/
venv/
env/
ENV/

# ─── Tool caches and test artefacts ───────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Built documentation ──────────────────────────────────────────────────────
# CI builds it on every push and deploys it to gh-pages, so a committed copy would
# be a second source of truth that can silently disagree with what is published.
# Preview locally with `mkdocs serve`.
site/

# ─── Graphify knowledge graph ─────────────────────────────────────────────────
# Regenerable, kept out of git deliberately (upstream suggests committing
# graphify-out/, but this repository's .git is already ~525 MB).
# NOTE: must be "graphify-out/", never "graph*" -- pear_ebi/embeddings/graph/ is
# real source.
graphify-out/
.graphify/

# ─── Editors and operating systems ────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Nothing here reads these, but an accidental commit of one is unrecoverable.
.env
.env.*
!.env.example

# ─── Vendored native build byproducts ─────────────────────────────────────────
# These were committed once (2149 files, 118 MB, including 441 CMake files carrying
# the maintainer's absolute home paths) and are regenerated by any local rebuild.
pear_ebi/calculate_distances/*/tqDist/build/
pear_ebi/calculate_distances/*/*/CMakeFiles/
pear_ebi/calculate_distances/*/*/CMakeCache.txt
pear_ebi/calculate_distances/*/*/.deps/
pear_ebi/calculate_distances/*/*/config.log
pear_ebi/calculate_distances/*/*/config.status
pear_ebi/calculate_distances/**/*.o

# ─── PEAR run outputs ─────────────────────────────────────────────────────────
# Everything a run writes into the working directory. The patterns follow the names
# the code actually builds (tree_set.py's plot/embedding names, hashrf.py and
# tqdist.py's matrices, maple_RF.py's pickle), so they are specific enough to leave
# tracked fixtures alone. A run started in the repository root used to leave these
# behind, and some of them were committed.
*_distance_matrix.csv
Set_collection_*
*_PCOA_embedding.csv
*_TSNE_embedding.csv
*_ISOMAP_embedding.csv
*_LLE_embedding.csv
PCoA_Embedding.csv
PCA_Embedding.csv
# plots: written as <stem>_<METHOD>_<2D|3D>, .html always and .pdf when saved
*_PCOA_2D.html
*_PCOA_3D.html
*_TSNE_2D.html
*_TSNE_3D.html
*_ISOMAP_2D.html
*_ISOMAP_3D.html
*_LLE_2D.html
*_LLE_3D.html
*_PCOA_2D.pdf
*_PCOA_3D.pdf
*_TSNE_2D.pdf
*_TSNE_3D.pdf
*_ISOMAP_2D.pdf
*_ISOMAP_3D.pdf
*_LLE_2D.pdf
*_LLE_3D.pdf
PCOA_2D.html
PCOA_3D.html
TSNE_2D.html
TSNE_3D.html
*_SUBSAMPLE
*_SUBSAMPLE_distances.csv
*.pckl
*.pkl
tmp_file

# ─── Notebook execution artefacts ─────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb
executed.ipynb
ex.ipynb
*.exec-input.ipynb
*.executed.ipynb

# ─── Deliberate fixtures: these two ARE tracked and must stay so ──────────────
!tests/beast_run1_distance_matrix.csv
!tests/PCA_Embedding.csv
